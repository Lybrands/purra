  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-sdk.mjs",
    "test": "node --test test/*.test.mjs",
    "test:types": "tsc -p test/tsconfig.json",
    "test:sdk": "tsc -p test/tsconfig.sdk.json && node --experimental-loader ./scripts/deny-langchain.mjs scripts/check-sdk.mjs && node --experimental-loader ./scripts/deny-langchain.mjs scripts/check-native-sdk.mjs",
    "check": "npm run build && npm test && npm run test:types",
    "prepack": "npm run build"
  },
