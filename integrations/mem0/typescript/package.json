{
  "name": "purra-mem0",
  "version": "0.5.1",
  "description": "Scoped Mem0 OSS memory integration for PurrA",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "test:types": "tsc -p test/tsconfig.json",
    "test:sdk": "tsc -p test/tsconfig.sdk.json && node scripts/check-sdk.mjs",
    "check": "npm run build && npm test && npm run test:types",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "mem0ai": "3.1.7",
    "purra": "0.5.1",
    "@langchain/core": "1.1.47"
  },
  "devDependencies": {
    "@langchain/core": "1.1.47",
    "@types/node": "22.20.1",
    "purra": "file:../../../typescript",
    "typescript": "7.0.2"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    }
  }
}
